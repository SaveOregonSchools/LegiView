[Unit]
Description=LegiView Oregon legislative archive
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=legiview
Group=legiview
WorkingDirectory=/opt/legiview
EnvironmentFile=/etc/legiview/legiview.env
ExecStart=/opt/legiview/.venv/bin/gunicorn --config /opt/legiview/deploy/gunicorn.conf.py app:app
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
